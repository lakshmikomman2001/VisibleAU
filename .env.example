# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Storage adapter — 'local' or 'supabase'
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/reports
DATABASE_URL=postgresql://postgres.[project-id]:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[project-id]:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Data residency log (lib/governance/residency-config.ts) — human-readable region labels shown
# to customers on the Data Residency settings page. Defaults reflect the current infra
# (Neon Postgres + Supabase Storage, both AWS ap-southeast-2 / Sydney); override only if either
# service is ever migrated to a different region.
NEON_REGION="AWS ap-southeast-2 (Sydney)"
SUPABASE_STORAGE_REGION="AWS ap-southeast-2 (Sydney)"

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Inngest
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# Resend
RESEND_API_KEY=re_...

# Feature flags
FREE_TIER_ENABLED_AU=true
FREE_TIER_ENABLED_NZ=true
FREE_TIER_ENABLED_UK=false
FREE_TIER_ENABLED_US=false
FREE_TIER_ENABLED_CA=false
FREE_TIER_ENABLED_EU=false

# LLM mode
LLM_MODE=mock

# Rate limiting (Upstash Redis) -- task #46 (18th follow-up). Vercel's
# Upstash Marketplace integration creates KV_REST_API_URL/KV_REST_API_TOKEN,
# not UPSTASH_REDIS_REST_URL/_TOKEN -- lib/sample-audit/rate-limit.ts's
# getRedisConfig() checks UPSTASH_REDIS_REST_URL/_TOKEN first, then falls
# back to these. Set whichever pair you actually have. Leave both empty
# locally -- the Postgres-backed fallback (lib/governance/pg-rate-limit.ts)
# covers local/CI correctly with no Redis at all.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
