# Template for .env.test.local (gitignored, not committed -- copy this
# file to .env.test.local and fill in real local values).
#
# Used by the "integration" vitest project (tests/phase2/**/*integration*,
# tests/integration/**) -- see docs/ops/post-launch-db-hardening.md
# section 46 for the full history of why these exist.

# App DB connection -- read by @/db/client and by anything that starts
# from the generic env vars (drizzle.config.ts, scripts/db/migrate-local.ts,
# scripts/qa/schema-drift-local.ts). Point this at a disposable local
# database only -- never anything named like prod, never a neon.tech host
# (scripts/db/local-db-guard.ts enforces this at runtime).
DATABASE_URL=postgresql://postgres:password@localhost:5432/visibleau_e2e
DIRECT_URL=postgresql://postgres:password@localhost:5432/visibleau_e2e

# Task #46 (7th/8th follow-up): the ONE place a test's own direct DB
# connection (tests/helpers/test-db-url.ts's getTestDatabaseUrl()) reads
# its target from. REQUIRED -- there is no fallback to DATABASE_URL (a
# test's target must never silently follow whatever else last set that
# variable). Same local-only restriction as DATABASE_URL above.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/visibleau_e2e

BETTER_AUTH_SECRET=test-secret-32-chars-minimum-here-ok
BETTER_AUTH_URL=http://localhost:3000
LLM_MODE=mock

# Test User 1
E2E_TEST_USER_EMAIL=sri@visibleau.local
E2E_TEST_USER_PASSWORD=password123
E2E_TEST_USER_1_EMAIL=sri@visibleau.local
E2E_TEST_USER_1_PASSWORD=password123
E2E_TEST_USER_1_CLERK_ID=...
E2E_TEST_ORG_1_CLERK_ID=...

# Test User 2
E2E_TEST_USER_2_EMAIL=user2@visibleau.local
E2E_TEST_USER_2_PASSWORD=password123
E2E_TEST_USER_2_CLERK_ID=...
E2E_TEST_ORG_2_CLERK_ID=...

# Feature flags
FREE_TIER_ENABLED_AU=true
FREE_TIER_ENABLED_UK=false

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_local_stub
STRIPE_WEBHOOK_SECRET=whsec_test
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...
STRIPE_PRICE_AGENCY_PRO_MONTHLY=price_...
STRIPE_PRICE_AGENCY_PRO_ANNUAL=price_...
STRIPE_PRICE_ONE_OFF_AUDIT=price_...

# Sample audit
SAMPLE_AUDIT_USE_REAL_LLM=false
SAMPLE_AUDIT_COST_CAP_AUD=1.00
SAMPLE_AUDIT_DAILY_SPEND_CAP_CENTS=2000
FX_AUD_USD=0.66

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
E2E_APP_URL=http://localhost:3000
INNGEST_EVENT_KEY=test

# Task #46 (13th follow-up): comma-separated allowlist gating
# /api/admin/db-role-check (and any future internal-only diagnostic
# route) -- lib/auth/platform-admin.ts. Unset = no one passes, including
# Sri; fails closed. Not org-scoped -- overrides whatever org/role the
# requester's own account has.
PLATFORM_ADMIN_EMAILS=sri@visibleau.local

# Upstash Redis (rate limiting for sample audit)
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=local-stub
