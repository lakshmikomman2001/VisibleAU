# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Task #46 (19th follow-up): both verified to contain only placeholder/
# empty values for every actual secret -- tracked so onboarding and
# Vercel setup have a real, current template instead of relying on
# whoever's local copy happens to be up to date.
!.env.example
!.env.production.example

# local storage (PDF reports written at runtime by STORAGE_DRIVER=local — root-level only,
# anchored so it doesn't also match lib/storage/, the source module)
/storage/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts -- wherever a Playwright config writes them (Playwright-run follow-ups, 9 Nov, part 6:
# its reports can hold whatever a config serialises)
test-results/
playwright-report/
blob-report/
playwright-results*.json
tests/qa/**/reports/
tests/qa/**/logs/

# temp files
tmp-*.sql

# Sri's local copies of prod-fix runs and queued prompts
*-READY.sql
db/prod-fixes/email/

# vitest's cache, wherever a config's root puts it
**/node_modules/.vite/
~$*
~*.tmp

# database backups (contain real data — NEVER commit)
*.dump
*_backup_*.sql
prod_backup_*.sql

# ad-hoc diagnostic/proof scripts (local-only)
_*.mjs

# local test artifacts
Test-Account.txt
dev-test.log

# Handoff bundles — reference material, never source
vunnara-project-bundle*
